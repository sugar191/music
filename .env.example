SECRET_KEY=ここに python -c "import secrets;print(secrets.token_urlsafe(50))" などで生成した値を入れる

# 開発環境は True / 本番環境は False（未設定時は False）
DEBUG=True

DB_NAME=music
DB_USER=root
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=3306

# /api/dump/* 用の共有トークン。未設定なら該当APIは常に401になる。
EXPORT_API_TOKEN=

# 書き込み系API(songs/create_with_artist, songs/update_credits)の認証要否。
# 未設定なら True(認証必須)。移行期間中のみ False にする。
REQUIRE_API_AUTH=True
